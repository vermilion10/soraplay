# URL your browser uses to open the app. The AniList login redirects back to
# <NONTON_PUBLIC_URL>/auth/callback, which must match the client's redirect URL.
NONTON_PUBLIC_URL=http://localhost:8787

# AniList API client, from https://anilist.co/settings/developer
ANILIST_CLIENT_ID=
ANILIST_CLIENT_SECRET=

# Optional
# NONTON_ADDR=:8787
# NONTON_DATA=data
